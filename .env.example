# ========================================================
# Emergency Resource Command Center - Environment Variables
# ========================================================

# Flask Application Settings
PORT=5000
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# PostgreSQL Database Connection
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
# Example for local PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/disaster_command_db
#
# Example for Neon / Supabase / Render:
# DATABASE_URL=postgresql://user:password@ep-cool-sample.us-east-2.aws.neon.tech/disaster_db?sslmode=require
#
# If DATABASE_URL is left unset or blank, system safely falls back to local persistent SQLite.
DATABASE_URL=

# Configurable Priority Weights (Must sum approximately to 1.0)
WEIGHT_FLOOD_RISK=0.40
WEIGHT_POPULATION=0.25
WEIGHT_VULNERABILITY=0.20
WEIGHT_URGENCY=0.15
